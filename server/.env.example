# ─────────────────────────────────────────────────────────────
# DATABASE & SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
PORT=5000

# ─────────────────────────────────────────────────────────────
# AUTHENTICATION (JWT)
# ─────────────────────────────────────────────────────────────
# Replace with a cryptographically secure 256-bit random key.
# Generate locally using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="YOUR_RANDOM_32_BYTE_HEX_SECRET_KEY"

# ─────────────────────────────────────────────────────────────
# PRESCRIPTION OCR CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Primary production engine is 'paddle' (PaddleOCR 2.10.0 / PP-OCRv4 via local Python worker)
# 'tesseract' is a developer-only legacy override for backwards-compatibility testing only
PRESCRIPTION_OCR_ENGINE=paddle
PYTHON_EXECUTABLE=
OCR_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY — TEST MODE ONLY
# ─────────────────────────────────────────────────────────────
# Use Razorpay TEST credentials only for this academic demonstration.
# DO NOT use live keys. DO NOT commit real credentials.
#
# Obtain free test keys from: https://dashboard.razorpay.com/
# (Sign up → Settings → API Keys → Test Mode)
# Simulated gateway responses are used when credentials are not configured.
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# ─────────────────────────────────────────────────────────────
# FULFILLMENT FEE CONFIGURATION (in INR)
# ─────────────────────────────────────────────────────────────
# PICKUP_FEE is always 0 INR (standard in-person pickup).
DELIVERY_FEE_INR=50
ASSISTANT_DELIVERY_FEE_INR=80
ENABLE_PLATFORM_FEE=true
