DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
PORT=5000
OCR_ENGINE="academic-heuristic"

# ─────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY — TEST MODE ONLY
# ─────────────────────────────────────────────────────────────
# Use Razorpay TEST credentials only for this academic demo.
# DO NOT use live keys. DO NOT commit real credentials.
#
# Obtain test keys from: https://dashboard.razorpay.com/
# (Sign up → Settings → API Keys → Test Mode)
#
# RAZORPAY_KEY_ID is safe to use in the frontend checkout loader.
# RAZORPAY_KEY_SECRET must NEVER be exposed to the frontend.
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─────────────────────────────────────────────────────────────
# FULFILLMENT FEE CONFIGURATION (in INR)
# ─────────────────────────────────────────────────────────────
# PICKUP_FEE is always 0 (hardcoded — no override).
DELIVERY_FEE_INR=50
ASSISTANT_DELIVERY_FEE_INR=80
